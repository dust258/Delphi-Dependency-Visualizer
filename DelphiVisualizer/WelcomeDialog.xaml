<Window x:Class="DelphiVisualizer.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DelphiVisualizer.Services"
        Title="{s:L welcome.title}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0E1A"
        Foreground="#E0E6F0">
  <StackPanel Margin="28,24,28,24">
    <TextBlock Text="{s:L welcome.heading}"
               Foreground="#E0E6F0" FontSize="18" FontWeight="SemiBold"
               TextWrapping="Wrap"/>
    <TextBlock Text="{s:L welcome.text}"
               Foreground="#8899BB" FontSize="12" Margin="0,10,0,20"
               TextWrapping="Wrap" LineHeight="18"/>

    <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}"
            HorizontalContentAlignment="Left" Padding="16,12"
            Background="#1A3A5A" BorderBrush="#2A5A8A" Foreground="#64B5F6"
            Click="BtnOpen_Click" IsDefault="True">
      <StackPanel Width="410" HorizontalAlignment="Left">
        <TextBlock Text="{s:L welcome.btnOpen}" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Text="{s:L welcome.btnOpenDesc}" FontSize="11" Foreground="#8FB8DE"
                   Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Button>

    <Button x:Name="BtnDemo" Style="{StaticResource ToolbarButton}"
            HorizontalContentAlignment="Left" Padding="16,12" Margin="0,10,0,0"
            Background="#12203A" BorderBrush="#1E2D50" Foreground="#E0E6F0"
            Click="BtnDemo_Click">
      <StackPanel Width="410" HorizontalAlignment="Left">
        <TextBlock Text="{s:L welcome.btnDemo}" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Text="{s:L welcome.btnDemoDesc}" FontSize="11" Foreground="#8899BB"
                   Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Button>

    <Button Content="{s:L welcome.btnLater}" Style="{StaticResource LayoutButton}"
            Width="90" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right"
            Click="BtnLater_Click" IsCancel="True"/>
  </StackPanel>
</Window>
