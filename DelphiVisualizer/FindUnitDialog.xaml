<Window x:Class="DelphiVisualizer.FindUnitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DelphiVisualizer.Services"
        Title="{s:L findunit.title}"
        Width="540" Height="440"
        MinWidth="380" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E1A"
        Foreground="#E0E6F0">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBox x:Name="TbFilter" Grid.Row="0"
             Style="{StaticResource SearchBox}"
             VerticalContentAlignment="Center"
             TextChanged="TbFilter_TextChanged"
             PreviewKeyDown="TbFilter_PreviewKeyDown"/>

    <ListBox x:Name="LbResults" Grid.Row="2"
             Background="#080C18" BorderBrush="#1E2D50" BorderThickness="1"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             ItemContainerStyle="{StaticResource UnitListItem}"
             MouseDoubleClick="LbResults_MouseDoubleClick"
             PreviewKeyDown="LbResults_PreviewKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                       VerticalAlignment="Center" Fill="{Binding Brush}"/>
              <TextBlock Text="{Binding Name}" FontSize="13"/>
            </StackPanel>
            <TextBlock Text="{Binding Path}" FontSize="10"
                       Foreground="#607090" Margin="14,1,0,0"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock x:Name="TbCount" VerticalAlignment="Center"
                 Foreground="#607090" FontSize="11" Margin="0,0,12,0"/>
      <Button Content="{s:L options.btnCancel}" Style="{StaticResource LayoutButton}"
              Width="90" Height="30" Margin="0,0,8,0"
              IsCancel="True" Click="BtnCancel_Click"/>
      <Button Content="{s:L findunit.btnSelect}" Style="{StaticResource ToolbarButton}"
              Width="100" Height="30"
              Background="#1A3A5A" BorderBrush="#2A5A8A" Foreground="#64B5F6"
              IsDefault="True" Click="BtnSelect_Click"/>
    </StackPanel>
  </Grid>
</Window>
